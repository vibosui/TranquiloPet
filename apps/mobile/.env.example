# Endereço LAN do computador que executa tools/dev-monitor.
# Não use localhost: no celular, localhost aponta para o próprio aparelho.
EXPO_PUBLIC_MONITOR_API_URL=http://IP_DO_COMPUTADOR:8000

# Opcional: habilita somente os dados locais ficticios em builds preview/release.
# Variaveis EXPO_PUBLIC_* ficam embutidas e visiveis no aplicativo; nunca use para segredos.
EXPO_PUBLIC_ENABLE_LOCAL_DEMO=0
