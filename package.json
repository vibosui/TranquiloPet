{
  "name": "hospeda-patas",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma mobile para hospedagem de pets com transparência, checklist e acompanhamento do cuidado.",
  "scripts": {
    "start": "npm run start --workspace=@hospeda-patas/mobile",
    "start:tunnel": "npm run start:tunnel --workspace=@hospeda-patas/mobile",
    "android": "npm run android --workspace=@hospeda-patas/mobile",
    "web": "npm run web --workspace=@hospeda-patas/mobile",
    "monitor": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-monitor.ps1",
    "lint": "npm run lint --workspace=@hospeda-patas/mobile",
    "typecheck": "npm run typecheck --workspace=@hospeda-patas/mobile",
    "test": "npm run test --workspace=@hospeda-patas/mobile"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "test-renderer": "1.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "react": "19.1.0",
    "test-renderer": "1.1.0"
  }
}
